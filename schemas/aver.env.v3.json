{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aver.build/schemas/env/v3",
  "title": "Environment",
  "description": "The pinned execution environment (ARCHITECTURE.md §1.4). v3 is v2 plus dependency layers of any ecosystem (layers, a set sorted by lockfile path, at most 16, none repeating the environment's own lockfile), a check's own image, deps (the lockfile paths of the layers it mounts, omitted when that is the environment's own lockfile alone) and covers, and the libtest, go-json, pytest-junit and tsc report formats. An environment carries v3 exactly when it uses one of those. checks is a set sorted by id, tests a set sorted by byte order.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "platform",
    "image",
    "install",
    "checks",
    "limits",
    "vars"
  ],
  "properties": {
    "schema": {
      "const": "aver.env/v3"
    },
    "platform": {
      "enum": [
        "linux/arm64",
        "linux/amd64"
      ]
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ref",
        "digest"
      ],
      "properties": {
        "ref": {
          "type": "string"
        },
        "digest": {
          "$ref": "https://aver.build/schemas/defs/v0#/$defs/Digest"
        }
      }
    },
    "lockfile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "blob"
      ],
      "properties": {
        "path": {
          "$ref": "https://aver.build/schemas/defs/v0#/$defs/Path"
        },
        "blob": {
          "$ref": "https://aver.build/schemas/defs/v0#/$defs/BlobId"
        }
      }
    },
    "install": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "argv",
        "allow_scripts"
      ],
      "properties": {
        "argv": {
          "$ref": "https://aver.build/schemas/defs/v0#/$defs/Argv"
        },
        "allow_scripts": {
          "type": "boolean"
        },
        "rebuild": {
          "description": "Run the dependencies' install scripts in a network-less sandbox after a script-free install. Omitted when false.",
          "const": true
        }
      }
    },
    "checks": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/CheckDef"
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cpu_millis",
        "memory_mb",
        "pids",
        "timeout_ms",
        "output_bytes"
      ],
      "properties": {
        "cpu_millis": {
          "$ref": "https://aver.build/schemas/defs/v0#/$defs/U32"
        },
        "memory_mb": {
          "$ref": "https://aver.build/schemas/defs/v0#/$defs/U32"
        },
        "pids": {
          "$ref": "https://aver.build/schemas/defs/v0#/$defs/U32"
        },
        "timeout_ms": {
          "$ref": "https://aver.build/schemas/defs/v0#/$defs/U32"
        },
        "output_bytes": {
          "$ref": "https://aver.build/schemas/defs/v0#/$defs/U32"
        }
      }
    },
    "vars": {
      "type": "object",
      "propertyNames": {
        "$ref": "https://aver.build/schemas/defs/v0#/$defs/EnvVarName"
      },
      "additionalProperties": {
        "type": "string"
      }
    },
    "tests": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/PathGlob"
      }
    },
    "layers": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/Layer"
      }
    }
  },
  "$defs": {
    "PathGlob": {
      "description": "Repo-relative pattern: '/'-separated, no empty, '.' or '..' segments, no NUL or backslash. '*' matches a run of characters within a segment, '?' one character, and a whole segment '**' any number of segments. A pattern also covers every path under a directory it matches.",
      "type": "string",
      "maxLength": 1024,
      "pattern": "^(?!(.*/)?\\.\\.?(/|$))(?!.*[^/]\\*\\*)(?!.*\\*\\*[^/])[^/\\\\\\x00]+(/[^/\\\\\\x00]+)*$"
    },
    "CheckDef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "argv"
      ],
      "properties": {
        "id": {
          "$ref": "https://aver.build/schemas/defs/v0#/$defs/CheckId"
        },
        "argv": {
          "$ref": "https://aver.build/schemas/defs/v0#/$defs/Argv"
        },
        "cwd": {
          "$ref": "https://aver.build/schemas/defs/v0#/$defs/Path"
        },
        "timeout_ms": {
          "$ref": "https://aver.build/schemas/defs/v0#/$defs/U32"
        },
        "report": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "format",
            "path"
          ],
          "properties": {
            "format": {
              "enum": [
                "junit",
                "jest-json",
                "mocha-xunit",
                "libtest",
                "go-json",
                "pytest-junit",
                "tsc",
                "tap"
              ]
            },
            "path": {
              "$ref": "https://aver.build/schemas/defs/v0#/$defs/ReportPath"
            }
          }
        },
        "setup": {
          "description": "Commands run in order before argv in the same sandbox; each runs even if an earlier one failed.",
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          }
        },
        "image": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "ref",
            "digest"
          ],
          "properties": {
            "ref": {
              "type": "string"
            },
            "digest": {
              "$ref": "https://aver.build/schemas/defs/v0#/$defs/Digest"
            }
          }
        },
        "deps": {
          "description": "The lockfile paths of the dependency layers the check mounts; absent: the environment's own lockfile layer.",
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "https://aver.build/schemas/defs/v0#/$defs/Path"
          }
        },
        "covers": {
          "description": "The files the check exercises, for the uncovered-change rule; absent: inferred from its image and cwd.",
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/PathGlob"
          }
        }
      }
    },
    "Layer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "lockfile",
        "install"
      ],
      "properties": {
        "kind": {
          "enum": [
            "npm",
            "uv",
            "pip",
            "cargo",
            "go"
          ]
        },
        "lockfile": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "blob"
          ],
          "properties": {
            "path": {
              "$ref": "https://aver.build/schemas/defs/v0#/$defs/Path"
            },
            "blob": {
              "$ref": "https://aver.build/schemas/defs/v0#/$defs/BlobId"
            }
          }
        },
        "install": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "argv",
            "allow_scripts"
          ],
          "properties": {
            "argv": {
              "$ref": "https://aver.build/schemas/defs/v0#/$defs/Argv"
            },
            "allow_scripts": {
              "type": "boolean"
            },
            "rebuild": {
              "description": "Run the dependencies' install scripts in a network-less sandbox after a script-free install. Omitted when false.",
              "const": true
            }
          }
        }
      }
    }
  }
}
