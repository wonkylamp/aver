{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aver.build/schemas/env/v1",
  "title": "Environment",
  "description": "The pinned execution environment (ARCHITECTURE.md §1.4). v1 is v0 plus tests, the test file patterns aver.toml declares; an environment carries v1 exactly when it declares them. checks is a set sorted by id, tests a set sorted by byte order.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "platform", "image", "install", "checks", "limits", "vars", "tests"],
  "properties": {
    "schema": { "const": "aver.env/v1" },
    "platform": { "enum": ["linux/arm64", "linux/amd64"] },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "digest"],
      "properties": {
        "ref": { "type": "string" },
        "digest": { "$ref": "https://aver.build/schemas/defs/v0#/$defs/Digest" }
      }
    },
    "lockfile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "blob"],
      "properties": {
        "path": { "$ref": "https://aver.build/schemas/defs/v0#/$defs/Path" },
        "blob": { "$ref": "https://aver.build/schemas/defs/v0#/$defs/BlobId" }
      }
    },
    "install": {
      "type": "object",
      "additionalProperties": false,
      "required": ["argv", "allow_scripts"],
      "properties": {
        "argv": { "$ref": "https://aver.build/schemas/defs/v0#/$defs/Argv" },
        "allow_scripts": { "type": "boolean" }
      }
    },
    "checks": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "https://aver.build/schemas/defs/v0#/$defs/CheckDef" }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cpu_millis", "memory_mb", "pids", "timeout_ms", "output_bytes"],
      "properties": {
        "cpu_millis": { "$ref": "https://aver.build/schemas/defs/v0#/$defs/U32" },
        "memory_mb": { "$ref": "https://aver.build/schemas/defs/v0#/$defs/U32" },
        "pids": { "$ref": "https://aver.build/schemas/defs/v0#/$defs/U32" },
        "timeout_ms": { "$ref": "https://aver.build/schemas/defs/v0#/$defs/U32" },
        "output_bytes": { "$ref": "https://aver.build/schemas/defs/v0#/$defs/U32" }
      }
    },
    "vars": {
      "type": "object",
      "propertyNames": { "$ref": "https://aver.build/schemas/defs/v0#/$defs/EnvVarName" },
      "additionalProperties": { "type": "string" }
    },
    "tests": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/PathGlob" }
    }
  },
  "$defs": {
    "PathGlob": {
      "description": "Repo-relative pattern: '/'-separated, no empty, '.' or '..' segments, no NUL or backslash. '*' matches a run of characters within a segment, '?' one character, and a whole segment '**' any number of segments. A pattern also covers every path under a directory it matches.",
      "type": "string",
      "maxLength": 1024,
      "pattern": "^(?!(.*/)?\\.\\.?(/|$))(?!.*[^/]\\*\\*)(?!.*\\*\\*[^/])[^/\\\\\\x00]+(/[^/\\\\\\x00]+)*$"
    }
  }
}
